  <style>
  /* small embedded styles for the role selector */
.role-select{display:flex;gap:1rem;justify-content:center;align-items:stretch;padding:0.5rem 0;}
.role-card{width:130px;height:150px;border:2px solid #eee;border-radius:12px;display:flex;flex-direction:column;align-items:center;justify-content:center;cursor:pointer;padding:10px;position:relative;transition:all .18s ease;}
.role-card:focus{outline:none;box-shadow:0 0 0 3px rgba(0,0,0,0.06);}
.role-card .role-img{width:64px;height:64px;object-fit:contain;margin-bottom:0.5rem;}
.role-label{font-weight:600;color:#222;}
.role-card .indicator{position:absolute;top:8px;right:8px;width:22px;height:22px;border-radius:50%;display:none;align-items:center;justify-content:center;color:#fff;font-size:12px;}
.role-card.selected{border-width:2px;}
.role-card.selected.doctor{border-color:#0d6efd;box-shadow:0 6px 18px rgba(13,110,253,0.08);}
.role-card.selected.patient{border-color:#198754;box-shadow:0 6px 18px rgba(25,135,84,0.08);}
.role-card.selected .indicator{display:flex;}
.role-card.selected.doctor .indicator{background:#0d6efd;}
.role-card.selected.patient .indicator{background:#198754;}
  </style>

  <script>
  /* minimal script to handle selection and open patient/doctor modal when NEXT is clicked */
(function(){
  const doctor = document.getElementById('role-doctor');
  const patient = document.getElementById('role-patient');
  const nextBtn = document.getElementById('roleNext');
  let selected = null;

  function setSelection(role){
    selected = role;
    doctor.classList.toggle('selected', role === 'doctor');
    doctor.classList.toggle('doctor', role === 'doctor');
    patient.classList.toggle('selected', role === 'patient');
    patient.classList.toggle('patient', role === 'patient');
    doctor.setAttribute('aria-pressed', role === 'doctor');
    patient.setAttribute('aria-pressed', role === 'patient');
    nextBtn.disabled = false;
  }

  doctor.addEventListener('click', () => setSelection('doctor'));
  patient.addEventListener('click', () => setSelection('patient'));
  // keyboard support
  doctor.addEventListener('keydown', (e)=> { if(e.key === 'Enter' || e.key === ' ') { e.preventDefault(); setSelection('doctor'); }});
  patient.addEventListener('keydown', (e)=> { if(e.key === 'Enter' || e.key === ' ') { e.preventDefault(); setSelection('patient'); }});

  nextBtn.addEventListener('click', () => {
    const current = bootstrap.Modal.getInstance(document.getElementById('exampleModalToggle')) || new bootstrap.Modal(document.getElementById('exampleModalToggle'));
    current.hide();
    setTimeout(() => {
      if (selected === 'patient') {
        new bootstrap.Modal(document.getElementById('exampleModalToggle2')).show();
      } else if (selected === 'doctor') {
        new bootstrap.Modal(document.getElementById('exampleModalToggle3')).show();
      }
    }, 200);
  });
})();
  </script>

