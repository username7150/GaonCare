 <script src="/socket.io/socket.io.js"></script>

<script>
  // get user info from server-rendered vars
  const userType = "<%= userType %>";
  const userId = "<%= currUser ? currUser._id : '' %>";

  // focus doctor login input when modal opens (handles backdrop issues and mobile tap)
  document.addEventListener('DOMContentLoaded', () => {
    const doctorModalEl = document.getElementById('exampleModalToggle3');
    if (doctorModalEl) {
      doctorModalEl.addEventListener('shown.bs.modal', () => {
        // remove any stray backdrops that could block clicks
        document.querySelectorAll('.modal-backdrop').forEach(el => el.remove());
        // focus the username input in the doctor login form
        const input = doctorModalEl.querySelector('#floatingInput') || doctorModalEl.querySelector('input[name="username"]');
        if (input) {
          input.focus();
          // on mobile ensure touch/focus works
          input.setAttribute('autofocus', 'autofocus');
        }
      });
    }

    // Only connect socket when the current user is a Doctor and logged in
    if (userType === "Doctor" && userId) {
      try {
        const socket = io({ query: { role: 'doctor', id: userId } });
        socket.on('connect', () => {
          socket.emit('joinDoctorRoom', userId);
          console.log("✅ Doctor socket connected and joined room:", "doctor_" + userId);
        });
        socket.on('notification', (data) => {
          // small in-page notification rather than alert
          try {
            if (window.Notification && Notification.permission === "granted") {
              new Notification(data.message);
            } else {
              alert("🔔 " + data.message);
            }
          } catch (e) {
            alert("🔔 " + data.message);
          }
        });
      } catch (e) {
        console.warn('Socket init failed', e);
      }
    } else {
      console.log("Not a logged-in doctor — skipping socket connect.");
    }
  });
</script>

