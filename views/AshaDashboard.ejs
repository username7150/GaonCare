<% layout('/Layouts/Boilerplate') -%>
<body>
  <main class="asha-auth-root">
    <section class="asha-auth-card">
      <div class="asha-visual">
        <img src="https://asha.nios.ac.in/dist/images/g_elem/13/3.png" alt="ASHA illustration" class="asha-image" />
        <h1>ASHA Portal</h1>
        <p class="muted">Register patients, raise emergency requests, sync offline data and manage visit reports.</p>
      </div>

      <div class="asha-forms">
        <div class="form-col login-col">
          <h2>ASHA Login</h2>
          <form id="ashaLogin" action="/asha/login" method="post" novalidate>
            <label class="field">
              <span>ASHA Username</span>
              <input name="username" type="text" placeholder="Username" required />
            </label>

            <label class="field">
              <span>Password</span>
              <div class="pw-wrap">
                <input name="password" id="loginPw" type="password" placeholder="Enter password" required />
                <button type="button" class="pw-toggle" id="toggleLoginPw">Show</button>
              </div>
            </label>

            <div class="form-actions">
              <button type="submit" class="btn primary">Sign In</button>
              <a class="link" href="/asha/forgot">Forgot password?</a>
            </div>

            <div id="loginError" class="form-error" aria-live="polite"></div>
          </form>
        </div>

        <div class="form-col signup-col">
          <h2>Create ASHA Account</h2>
          <form id="ashaSignup" action="/asha/register" method="post" novalidate>
            <label class="field">
              <span>Full name</span>
              <input name="fullName" type="text" placeholder="e.g. Sita Devi" required />
            </label>

            <label class="field">
              <span>ASHA ID</span>
              <input name="ashaId" type="text" placeholder="ASHA-12345" required />
            </label>

            <div class="two-cols">
              <label class="field">
                <span>Phone</span>
                <input name="phone" type="tel" placeholder="Mobile number" required />
              </label>
              <label class="field">
                <span>Pincode</span>
                <input name="pincode" type="text" placeholder="PIN" />
              </label>
            </div>

            <label class="field">
              <span>Village / Area</span>
              <input name="village" type="text" placeholder="Village name" />
            </label>

            <label class="field">
              <span>Email (optional)</span>
              <input name="email" type="email" placeholder="asha@example.com" />
            </label>

            <label class="field">
              <span>Password</span>
              <div class="pw-wrap">
                <input name="password" id="signupPw" type="password" placeholder="Create password" required />
                <button type="button" class="pw-toggle" id="toggleSignupPw">Show</button>
              </div>
            </label>

            <label class="field">
              <span>Confirm Password</span>
              <input name="confirmPassword" id="confirmPw" type="password" placeholder="Repeat password" required />
            </label>

            <label class="checkbox-inline">
              <input type="checkbox" name="agree" required /> I confirm these details are correct
            </label>

            <div class="form-actions">
              <button type="submit" class="btn primary">Create Account</button>
            </div>

            <div id="signupError" class="form-error" aria-live="polite"></div>
          </form>
        </div>
      </div>
    </section>
  </main>

<style>
  :root {
    --card-bg: #fff;
    --accent: #0d6efd;
    --success: #28a745;
    --muted: #64748b;
    --radius: 12px;
  }
  body { background: linear-gradient(180deg,#fbfbff,#f6f9ff); }

  .asha-auth-root{min-height:80vh;display:flex;align-items:center;justify-content:center;padding:2rem}
  .asha-auth-card{max-width:1200px;width:100%;display:grid;grid-template-columns:1fr 1fr;gap:2rem;padding:2rem;border-radius:var(--radius);background:var(--card-bg);border:1px solid #e9eef6;box-shadow:0 12px 30px rgba(15,23,42,0.06)}

  .asha-visual{display:flex;flex-direction:column;gap:1rem;align-items:center;justify-content:center;padding:1rem ;margin-bottom:40rem;}
  .asha-image{width:100%;max-width:520px;height:auto;border-radius:10px;border:1px solid #eef4fb;padding:0.6rem;  background: #fff;box-shadow:0 8px 20px rgba(10,30,60,0.04)}
  .asha-visual h1{margin:0;font-size:1.6rem;color:#0b3b2e}
  .asha-visual .muted{color:var(--muted);text-align:center;max-width:520px}

  .asha-forms{display:flex;flex-direction:column;gap:1rem;padding:0.6rem}
  .form-col{background:linear-gradient(180deg,#fff,#fbfdff);padding:1.1rem;border-radius:10px;border:1px solid #e6eef5}
  .form-col h2{margin:0 0 0.5rem 0;color:#063a2b}
  .field{display:block;margin-bottom:0.5rem;font-size:0.95rem}
  .field span{display:block;margin-bottom:0.25rem;color:#2b3b36;font-weight:600}

  /* compact input styles (smaller height, professional look) */
  .field input,
  .field select,
  .field textarea {
    width:100%;
    padding:0.32rem 0.5rem;          /* smaller vertical padding */
    min-height:34px;                /* compact height */
    border-radius:6px;
    border:1px solid #d7e1ea;
    font-size:0.94rem;
    line-height:1.2;
    background:#fff;
    box-sizing:border-box;
  }
  .field textarea { min-height:72px; padding-top:0.45rem; padding-bottom:0.45rem; }

  .two-cols{display:flex;gap:0.5rem}
  .two-cols .field{flex:1;margin-bottom:0}

  .pw-wrap{display:flex;align-items:center;gap:0.4rem}
  .pw-toggle{background:transparent;border:none;color:var(--accent);font-weight:700;cursor:pointer;padding:0.25rem 0.4rem;border-radius:6px}
  .checkbox-inline{display:flex;align-items:center;gap:0.5rem;font-size:0.95rem;margin-top:0.4rem}

  .form-actions{display:flex;align-items:center;gap:0.6rem;margin-top:0.5rem}
  .btn{padding:0.5rem 0.9rem;border-radius:8px;border:none;cursor:pointer;font-weight:700}
  .btn.primary{background:var(--accent);color:#fff;box-shadow:0 8px 20px rgba(13,110,253,0.12)}
  .link{color:var(--accent);text-decoration:none}
  .form-error{color:#b00020;font-weight:600;margin-top:0.4rem}

  @media (max-width:980px){
    .asha-auth-card{grid-template-columns:1fr;gap:1rem}
    .asha-image{max-width:360px}
    .asha-forms{order:2}
  }

  @media (max-width:720px){
    .two-cols{flex-direction:column}
    .asha-image{max-width:320px}
  }
</style>


  <script>
    (function(){
      // password toggles
      const toggleLogin = document.getElementById('toggleLoginPw');
      const loginPw = document.getElementById('loginPw');
      const toggleSignup = document.getElementById('toggleSignupPw');
      const signupPw = document.getElementById('signupPw');

      if (toggleLogin && loginPw) {
        toggleLogin.addEventListener('click', () => {
          loginPw.type = loginPw.type === 'password' ? 'text' : 'password';
          toggleLogin.textContent = loginPw.type === 'password' ? 'Show' : 'Hide';
        });
      }
      if (toggleSignup && signupPw) {
        toggleSignup.addEventListener('click', () => {
          signupPw.type = signupPw.type === 'password' ? 'text' : 'password';
          toggleSignup.textContent = signupPw.type === 'password' ? 'Show' : 'Hide';
        });
      }

      // simple signup validation (password match)
      const signupForm = document.getElementById('ashaSignup');
      const signupError = document.getElementById('signupError');
      if (signupForm) {
        signupForm.addEventListener('submit', (e) => {
          signupError.textContent = '';
          const pw = document.getElementById('signupPw').value || '';
          const cpw = document.getElementById('confirmPw').value || '';
          if (pw.length < 6) {
            e.preventDefault();
            signupError.textContent = 'Password must be at least 6 characters';
            return;
          }
          if (pw !== cpw) {
            e.preventDefault();
            signupError.textContent = 'Passwords do not match';
            return;
          }
          // allow submit to server
        });
      }

      // login validation
      const loginForm = document.getElementById('ashaLogin');
      const loginError = document.getElementById('loginError');
      if (loginForm) {
        loginForm.addEventListener('submit', (e) => {
          loginError.textContent = '';
          const id = loginForm.username.value.trim();
          const pw = loginForm.password.value.trim();
          if (!id || !pw) {
            e.preventDefault();
            loginError.textContent = 'ASHA ID and password are required';
          }
        });
      }
    })();
  </script>
</body>