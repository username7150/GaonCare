<% layout('/Layouts/Boilerplate') -%>
<body>
  <main class="asha-auth-root">
    <section class="asha-auth-card">
      <div class="asha-visual">
        <img
          src="https://asha.nios.ac.in/dist/images/g_elem/13/3.png"
          alt="ASHA illustration"
          class="asha-image"
        />
        <h1>ASHA Portal</h1>
        <p class="muted">
          Register patients, raise emergency requests, sync offline data and
          manage visit reports.
        </p>
      </div>

<!-- Asha login form.................................................................................. -->

      <div class="asha-forms">
        <div class="form-col login-col">
          <h2>Sign In</h2>
          <form id="ashaLogin" action="/asha/login" method="post" novalidate>
            <label class="field">
              <span class="label-txt">ASHA Username</span>
              <input
                name="username"
                type="text"
                placeholder="Username"
                required
              />
            </label>

            <label class="field">
              <span class="label-txt">Password</span>
              <div class="pw-wrap">
                <input
                  name="password"
                  id="loginPw"
                  type="password"
                  placeholder="Enter password"
                  required
                />
                <button type="button" class="pw-toggle" id="toggleLoginPw">
                  Show
                </button>
              </div>
            </label>

            <div class="form-actions">
              <button type="submit" class="btn primary">Sign In</button>
              <a class="link" href="/asha/forgot">Forgot?</a>
            </div>

            <div id="loginError" class="form-error" aria-live="polite"></div>
          </form>
        </div>
<!-- Asha signup form.................................................................................. -->
        <div class="form-col signup-col">
          <h2>Create Account</h2>
          <form id="ashaSignup" action="/asha/signup" method="post" novalidate>
            <label class="field">
              <span class="label-txt">Full name</span>
              <input
                name="asha[fullName]"
                type="text"
                placeholder="e.g. Sita Devi"
                required
              />
            </label>

            <label class="field">
              <span class="label-txt">ASHA Username</span>
              <!-- changed name to 'username' so model receives expected key -->
              <input
                name="asha[username]"
                type="text"
                placeholder="ASHA-12345"
                required
              />
            </label>

            <div class="two-cols">
              <label class="field">
                <span class="label-txt">Phone</span>
                <input
                  name="phone"
                  type="tel"
                  placeholder="Mobile number"
                  required
                />
              </label>
              <label class="field">
                <span class="label-txt">Location</span>
                <input name="asha[location]" type="text" placeholder="location" />
              </label>
            </div>

            <label class="field">
              <span class="label-txt">Password</span>
              <div class="pw-wrap">
                <input
                  name="asha[password]"
                  id="signupPw"
                  type="password"
                  placeholder="Create password"
                  required
                />
                <button type="button" class="pw-toggle" id="toggleSignupPw">
                  Show
                </button>
              </div>
            </label>

            <label class="checkbox-inline">
              <input type="checkbox"  required /> I confirm
              these details are correct
            </label>

            <div class="form-actions">
              <button type="submit" class="btn primary">Create</button>
            </div>

            <div id="signupError" class="form-error" aria-live="polite"></div>
          </form>
        </div>
      </div>
    </section>
  </main>

  <style>
    :root {
      --card-bg: #fff;
      --accent: #0d6efd;
      --muted: #64748b;
      --radius: 10px;
    }
    body {
      background: linear-gradient(180deg, #fbfbff, #f6f9ff);
    }

    .asha-auth-root {
      min-height: 68vh;
      display: flex;
      align-items: center;
      justify-content: center;
      padding: 0.8rem;
    }

    /* make visual column larger so image is prominent */
    .asha-auth-card {
      max-width: 940px;
      width: 100%;
      display: grid;
      grid-template-columns: 340px 1fr; /* larger visual column */
      gap: 0.8rem;
      padding: 0.8rem;
      border-radius: var(--radius);
      background: var(--card-bg);
      border: 1px solid #e9eef6;
      box-shadow: 0 10px 26px rgba(15, 23, 42, 0.06);
    }

    /* visual - bigger, centered */
    .asha-visual {
      display: flex;
      flex-direction: column;
      gap: 0.5rem;
      align-items: center;
      justify-content: flex-start;
      padding: 0.4rem;
    }
    .asha-image {
      width: 100%;
      max-width: 300px; /* increased max width */
      height: auto;
      border-radius: 10px;
      border: 1px solid #eef4fb;
      padding: 0.35rem;
      background: #fff;
      box-shadow: 0 8px 18px rgba(10, 30, 60, 0.05);
    }
    .asha-visual h1 {
      margin: 0;
      font-size: 1.12rem;
      color: #063a2b;
    }
    .asha-visual .muted {
      color: var(--muted);
      text-align: center;
      font-size: 0.86rem;
      max-width: 260px;
    }

    /* compact forms container - both visible without scroll */
    .asha-forms {
      display: grid;
      grid-template-columns: 1fr 1fr;
      gap: 0.6rem;
      padding: 0;
      align-items: start;
    }
    .form-col {
      background: linear-gradient(180deg, #fff, #fbfdff);
      padding: 0.64rem; /* reduced padding */
      border-radius: 8px;
      border: 1px solid #e6eef5;
      min-height: 1px;
    }
    .form-col h2 {
      margin: 0 0 0.4rem 0;
      color: #063a2b;
      font-size: 0.96rem;
    }
    .field {
      display: block;
      margin-bottom: 0.34rem;
      font-size: 0.82rem;
    }
    .label-txt {
      display: block;
      margin-bottom: 0.16rem;
      color: #2b3b36;
      font-weight: 700;
      font-size: 0.78rem;
    }

    /* tighter, compact inputs */
    .field input,
    .field select,
    .field textarea {
      width: 100%;
      padding: 0.2rem 0.48rem; /* smaller vertical padding */
      min-height: 30px; /* compact height */
      border-radius: 6px;
      border: 1px solid #d7e1ea;
      font-size: 0.86rem;
      line-height: 1.05;
      background: #fff;
      box-sizing: border-box;
    }
    .two-cols {
      display: flex;
      gap: 0.45rem;
    }
    .two-cols .field {
      flex: 1;
      margin-bottom: 0;
    }

    .pw-wrap {
      display: flex;
      align-items: center;
      gap: 0.36rem;
    }
    .pw-toggle {
      background: transparent;
      border: none;
      color: var(--accent);
      font-weight: 700;
      cursor: pointer;
      padding: 0.12rem 0.28rem;
      border-radius: 6px;
      font-size: 0.8rem;
    }
    .checkbox-inline {
      display: flex;
      align-items: center;
      gap: 0.45rem;
      font-size: 0.82rem;
      margin-top: 0.18rem;
    }

    .form-actions {
      display: flex;
      align-items: center;
      gap: 0.5rem;
      margin-top: 0.42rem;
    }
    .btn {
      padding: 0.36rem 0.64rem;
      border-radius: 8px;
      border: none;
      cursor: pointer;
      font-weight: 700;
      font-size: 0.86rem;
    }
    .btn.primary {
      background: var(--accent);
      color: #fff;
      box-shadow: 0 8px 20px rgba(13, 110, 253, 0.12);
    }
    .link {
      color: var(--accent);
      text-decoration: none;
      font-size: 0.84rem;
    }
    .form-error {
      color: #b00020;
      font-weight: 600;
      margin-top: 0.28rem;
      font-size: 0.84rem;
    }

    @media (max-width: 980px) {
      .asha-auth-card {
        grid-template-columns: 1fr;
        gap: 0.6rem;
        padding: 0.6rem;
      }
      .asha-visual {
        order: 1;
        flex-direction: row;
        gap: 0.6rem;
        align-items: center;
      }
      .asha-visual .muted {
        display: none;
      }
      .asha-forms {
        grid-template-columns: 1fr;
        order: 2;
        gap: 0.5rem;
      }
    }

    @media (max-width: 520px) {
      .asha-image {
        max-width: 160px;
      }
      .label-txt {
        font-size: 0.76rem;
      }
      .form-col h2 {
        font-size: 0.92rem;
      }
    }
  </style>

  <script>
    (function () {
      // password toggles
      const toggleLogin = document.getElementById("toggleLoginPw");
      const loginPw = document.getElementById("loginPw");
      const toggleSignup = document.getElementById("toggleSignupPw");
      const signupPw = document.getElementById("signupPw");

      if (toggleLogin && loginPw) {
        toggleLogin.addEventListener("click", () => {
          loginPw.type = loginPw.type === "password" ? "text" : "password";
          toggleLogin.textContent =
            loginPw.type === "password" ? "Show" : "Hide";
        });
      }
      if (toggleSignup && signupPw) {
        toggleSignup.addEventListener("click", () => {
          signupPw.type = signupPw.type === "password" ? "text" : "password";
          toggleSignup.textContent =
            signupPw.type === "password" ? "Show" : "Hide";
        });
      }

      // simple signup validation (password match)
      const signupForm = document.getElementById("ashaSignup");
      const signupError = document.getElementById("signupError");
      if (signupForm) {
        signupForm.addEventListener("submit", (e) => {
          signupError.textContent = "";
          const pw = document.getElementById("signupPw").value || "";
          const cpw = document.getElementById("confirmPw").value || "";
          if (pw.length < 6) {
            e.preventDefault();
            signupError.textContent = "Password must be at least 6 characters";
            return;
          }
          if (pw !== cpw) {
            e.preventDefault();
            signupError.textContent = "Passwords do not match";
            return;
          }
          // allow submit to server
        });
      }

      // login validation
      const loginForm = document.getElementById("ashaLogin");
      const loginError = document.getElementById("loginError");
      if (loginForm) {
        loginForm.addEventListener("submit", (e) => {
          loginError.textContent = "";
          const id =
            (loginForm.username &&
              loginForm.username.value &&
              loginForm.username.value.trim()) ||
            "";
          const pw =
            (loginForm.password &&
              loginForm.password.value &&
              loginForm.password.value.trim()) ||
            "";
          if (!id || !pw) {
            e.preventDefault();
            loginError.textContent = "ASHA ID and password are required";
          }
        });
      }
    })();
  </script>
</body>
