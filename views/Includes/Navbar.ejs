   <nav class="navbar navbar-expand-lg bg-body-tertiary">
  <div class="container-fluid">
    <a href="/GaonCare" class="logo" style="font-size: 1.5rem; font-weight: bold; text-decoration: none">
      <span><i class="fa-solid fa-truck-medical"></i></span>
      Gaon<span style="color: #28a745">Care</span>
    </a>

    <button class="navbar-toggler" type="button" data-bs-toggle="collapse" data-bs-target="#navbarNavAltMarkup"
      aria-controls="navbarNavAltMarkup" aria-expanded="false" aria-label="Toggle navigation">
      <span class="navbar-toggler-icon"></span>
    </button>

    <div class="collapse navbar-collapse" id="navbarNavAltMarkup">
      <div class="navbar-nav me-auto">
        <a class="nav-link" aria-current="page" href="/loginUserForm" style="font-weight: 600;">My Bookings</a>
        <a class="nav-link" aria-current="page" href="/loginUserForm" style="font-weight: 600;">VideoConsult</a>
        <a class="nav-link" aria-current="page" href="/loginUserForm" style="font-weight: 600;">About-us</a>
        <a class="nav-link" aria-current="page" href="/loginUserForm" style="font-weight: 600;">Contact-us</a>
      </div>

      <div class="d-flex align-items-center">
        <% if (!currUser) { %>
           <!-- ASHA portal quick access -->
          <a href="/Asha" class="btn btn-success ashalogin-btn" style="font-weight:600; margin-right:0.5rem;">
            <i class="fa-solid fa-user-nurse"></i> ASHA Login
          </a>
          <!-- Login / Signup -->
          <button class="btn btn-secondary"  data-bs-toggle="modal" data-bs-target="#exampleModalToggle" style="margin-right:0.5rem;">
            <i class="fa-solid fa-user"></i> Login / Signup
          </button>

         
        <% } else { %>
          <!-- Logged in: Profile + Logout -->
          <a href="/profile" class="nav-link" style="font-weight:600; margin-right:0.5rem;">Profile</a>
          <form action="/logout" method="post" style="display:inline">
            <button type="submit" class="btn btn-secondary">Logout</button>
          </form>
        <% } %>
      </div>
    </div>
  </div>
</nav>